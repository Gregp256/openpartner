# Rendered at container start from /etc/nginx/templates/default.conf.template
# by the nginx:alpine entrypoint. API_UPSTREAM defaults to the compose
# service name; override for Fly / standalone deployments. On App Platform
# the ingress sends /api to the api component before the portal sees it,
# so .do/app.yaml points API_UPSTREAM at an address nginx needn't resolve.

# TLS terminates at the deployment proxy; the portal receives plain HTTP.
# Preserve only recognized schemes, falling back to the local connection.
# Expose this container through a proxy that overwrites client-supplied headers.
map $http_x_forwarded_proto $api_forwarded_proto {
    default $scheme;
    http http;
    https https;
}

server {
    listen       8080 default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Gzip on for text assets — helps the JS bundle + CSS.
    gzip             on;
    gzip_comp_level  5;
    gzip_types       text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length  512;

    # Long cache only for Vite's hashed output, no-cache for index.html so
    # new builds are seen immediately. ^~ keeps the regex below from
    # claiming /assets/*.js.
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Unhashed files at the root keep their names across builds: /op.js,
    # which brands' own sites load, plus favicons and logos. A year-long
    # immutable cache would pin visitors to an old op.js, so browsers
    # revalidate after 10s while a CDN may keep a day (App Platform's edge
    # purges on deploy). A missing file is a 404, not index.html.
    location ~ \.(js|css|svg|woff2|png|jpg|gif|ico)$ {
        add_header Cache-Control "public, max-age=10, s-maxage=86400";
        try_files $uri =404;
    }

    # No site may frame the portal, this one included: a framed sign-in or
    # magic-link page can be overlaid and clicked through (clickjacking).
    # Nothing embeds the portal; its own iframes are outbound video players.
    # X-Frame-Options covers browsers without CSP frame-ancestors.
    #
    # add_header is inherited only by a location that declares none of its
    # own, so each location that answers with HTML repeats the pair: this
    # one (every SPA route lands here via try_files) and the fallback below.
    # /api/ declares none and stays that way, so the API's helmet headers
    # pass through without a second, conflicting copy from nginx.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
    }

    # Proxy /api/* to the API service. The API's own /api prefix is
    # stripped so the API continues to see /attribution/events etc.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $api_forwarded_proto;
        proxy_read_timeout 30s;
    }

    # Personal links (/r/sara) are served by the click router on this same host.
    location /r/ {
        proxy_pass http://${ROUTER_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $api_forwarded_proto;
    }

    # SPA routes the portal knows: index.html with 200 so react-router
    # owns client-side routing. Keep this list in step with the top-level
    # <Route> paths in src/App.tsx and APP_SECTIONS in lib/affiliateHost.ts.
    location ~ ^/(?:(?:login|admin-login|forgot-password|signup|join|terms|faq|privacy|auth|reset-password|go|signin|workspaces|brands|account|platform|creator|creators|reports|booking|install|t|links|commissions|payouts|payout-details|payout-sent|connect|coupons|bounties|postbacks|admin|network|referrals|recruit|claim)(?:/.*)?)?$ {
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri /index.html;
    }

    # Anything else is a real 404. The body is still index.html, so the
    # SPA renders its own "Page not found" page, but crawlers and link
    # checkers get the right status instead of a 200 that looks like login.
    location / {
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        error_page 404 /index.html;
        try_files $uri =404;
    }
}
